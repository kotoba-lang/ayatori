{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) this bridge materializes FROM. arrangement
 ;; (kotoba-lang/arrangement) provides the 4-covering triple index
 ;; (arrangement.core) this bridge materializes INTO, and the real
 ;; Datomic-shaped Datalog engine (arrangement.datalog) that runs queries
 ;; over it -- this repo is a thin bridge between the two, not a
 ;; reimplementation of either. io-ipni-specs provides provider discovery;
 ;; it does not fetch, verify, traverse, or query IPLD data. `kqe` (named in
 ;; ADR-2607172300's dependency
 ;; table) is NOT a direct dep: it is retired upstream, merged into
 ;; `arrangement` as `arrangement.query`/`arrangement.datalog` -- see the
 ;; ns docstrings in `src/ayatori/query.cljc` and
 ;; `src/ayatori/discovery.cljc`.
 ;;
 ;; `ayatori.remote` directly uses io-ipld for verification and
 ;; io-multiformats for advertised gateway addresses. `ayatori.pack` uses
 ;; io-ipld-car for the CARv2 codec and its index -- reading packs, never
 ;; writing them; a second encoder is how the `:file-offset` versus
 ;; `:payload-offset` convention drifts. `arrangement` pulls in
 ;; prolly-tree/datom-source/datalog; tools.deps resolves the remaining chain
 ;; from the pinned direct deps below for the JVM :test alias. The nbb primary test path
 ;; has no dependency resolver, so `bin/run_tests.cljs` / CI clone each of
 ;; those transitive deps into their own `.deps/<name>` and list every
 ;; src dir on --classpath by hand -- see the README's Develop/test section
 ;; for the exact command.
 :deps {io.github.kotoba-lang/kotobase
        {:git/sha "8484ed8f0102db81e020e4b5fa401d3e47f3caca"}
        io.github.kotoba-lang/arrangement
        {:git/sha "9c9f45d4cd043873cd5c5ea65fa3af8a8ead5e6d"}
        io.github.kotoba-lang/io-ipld
        {:git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}
        ;; Pinned to the merged CARv2 index resource-limit + characteristics
        ;; change (ADR-2609060000 rollout item 2). `ayatori.pack` calls
        ;; `car2/no-characteristics?`, which does not exist before it, and
        ;; relies on `idx/decode` refusing a truncated index rather than
        ;; returning the empty one it cannot be told apart from.
        io.github.kotoba-lang/io-ipld-car
        {:git/sha "79436d12da879356dcc47387bfacf991354eac99"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}
        io.github.kotoba-lang/io-ipni-specs
        {:git/sha "2c1559e2703bf41076188539c7086255b0d3c540"}
        ;; `ayatori.disclosure-open` builds the `:open!` port on
        ;; `envelope.sealed-key`: the hybrid X25519 + ML-KEM-768 wrap of one
        ;; content key, framed as the octet vector a grant's
        ;; `:sealed/ciphertext` carries. Direct, not transitive through
        ;; kotobase, because kotobase deliberately holds no crypto -- the
        ;; provider is the host's, and here the host is this repo.
        ;;
        ;; Pinned to the commit whose `envelope.qualify` binds the ML-KEM
        ;; module digest that `kotoba.security.crypto-policy/
        ;; evaluate-pq-provider` was run against. Moving this pin without
        ;; re-running `npm run qualify:ml-kem` in that repo means the
        ;; provider under this port is no longer the qualified one.
        io.github.kotoba-lang/envelope
        {:git/url "https://github.com/kotoba-lang/envelope.git"
         :git/sha "16d65d5d96e6ff25d83a70e663f25a0f7d2970eb"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;; the exact classpath lives in bin/run_tests.cljs, which is the runner.
 ;; The :test alias below is the :clj COMPAT suite only -- not the
 ;; primary execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
